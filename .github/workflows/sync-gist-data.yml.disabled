name: sync-gist-data

on:
  schedule:
    - cron: "*/5 * * * *"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Pull gist into data.json
        env:
          GIST_TOKEN: ${{ secrets.GIST_TOKEN }}
        run: |
          set -e
          curl -sf -H "Authorization: Bearer $GIST_TOKEN" \
            -H "Accept: application/vnd.github+json" \
            https://api.github.com/gists/4bb6f3b536c05a65de7132179a8826e9 -o gist.json
          node -e "const fs=require('fs');const j=JSON.parse(fs.readFileSync('gist.json','utf8'));const f=j.files['zhuhai-chida.json'];if(!f||!f.content)process.exit(2);fs.writeFileSync('data.json',f.content);"
          rm -f gist.json
      - name: Commit if changed
        run: |
          git config user.name "liqian-bot"
          git config user.email "liqian-bot@users.noreply.github.com"
          git add data.json
          if git diff --staged --quiet; then echo "no change"; else git commit -m "sync data.json"; git push; fi
